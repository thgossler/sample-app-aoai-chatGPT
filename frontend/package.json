    "@fluentui/react-icons": "^2.0.346",
    "dompurify": "^3.0.8",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "react-syntax-highlighter": "^16.1.2",
    "react-uuid": "^2.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-supersub": "^1.0.0"
