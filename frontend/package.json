    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-util": "^29.7.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.2.5",
    "react-test-renderer": "^19.3.1",
    "string.prototype.replaceall": "^1.0.10",
    "ts-jest": "^29.4.15",
