# ── Remote MCP Server (Outward-Facing Streamable HTTP) ──────────────────────
# Enable the remote MCP endpoint at POST/GET/DELETE /mcp
REMOTE_MCP_SERVER_ENABLED=false
# Public URL of the MCP server (used in the PRM discovery document)
REMOTE_MCP_SERVER_URL=https://your-chat-app.azurewebsites.net/mcp
# Internal path prefix (default: /mcp)
# REMOTE_MCP_SERVER_PATH=/mcp

# Human-readable agent/product name inserted into MCP tool descriptions.
# E.g. "R&D Buddy" → "Search the R&D Buddy knowledge base …"
# Leave blank to use the generic fallback text.
# REMOTE_MCP_AGENT_NAME=

# Entra ID tenant where the server app registration lives
REMOTE_MCP_AUTH_TENANT_ID=
# Application (client) ID of the server app registration
REMOTE_MCP_AUTH_CLIENT_ID=
# Comma-separated list of trusted MCP client app IDs.
# Include VS Code's built-in ID for VS Code Copilot support:
REMOTE_MCP_AUTH_ALLOWED_CLIENT_IDS=aebc6443-996d-45c2-90f0-388ff96faa56
# Set to true if the server app supports multi-tenant logins
# REMOTE_MCP_AUTH_MULTI_TENANT=false
# Override auto-derived values (leave blank to use Entra ID defaults):
# REMOTE_MCP_AUTH_AUDIENCE=api://<client-id>
# REMOTE_MCP_AUTH_ISSUER=https://sts.windows.net/<tenant-id>/
# REMOTE_MCP_AUTH_DEFAULT_SCOPE=api://<client-id>/.default
# Client secret (for advanced scenarios only; not needed for RS256 token validation)
# REMOTE_MCP_AUTH_CLIENT_SECRET=

